{
  "name": "nori",
  "version": "0.0.1",
  "description": "Embeddable practice SDK and headless SQLite/LLM sidecar for personal static learning sites",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azusachino/nori.git"
  },
  "homepage": "https://github.com/azusachino/nori#readme",
  "bugs": {
    "url": "https://github.com/azusachino/nori/issues"
  },
  "keywords": [
    "learning",
    "practice",
    "sdk",
    "sidecar",
    "sqlite",
    "react",
    "bun"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/sdk/index.ts",
      "default": "./src/sdk/index.ts"
    },
    "./react": {
      "types": "./src/sdk/react.tsx",
      "default": "./src/sdk/react.tsx"
    },
    "./styles.css": "./src/sdk/nori.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/sdk",
    "src/sdk",
    "!src/sdk/**/*.test.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "umask 077 && bun --bun vite dev --port 3000",
    "build": "bun --bun vite build",
    "build:sdk": "rm -rf dist/sdk && tsc -p tsconfig.sdk.json",
    "start": "umask 077 && NITRO_HOST=127.0.0.1 HOST=127.0.0.1 bun .output/server/index.mjs",
    "sidecar": "umask 077 && bun run src/sidecar-server.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "nitro": "3.0.260610-beta",
    "radix-ui": "1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.7.0",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}