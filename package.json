{
  "name": "nori",
  "version": "0.2.0",
  "description": "Embeddable practice SDK and headless SQLite/LLM sidecar for personal static learning sites",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azusachino/nori.git"
  },
  "homepage": "https://github.com/azusachino/nori#readme",
  "bugs": {
    "url": "https://github.com/azusachino/nori/issues"
  },
  "keywords": [
    "learning",
    "practice",
    "sdk",
    "sidecar",
    "sqlite",
    "drizzle",
    "react",
    "bun"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/sdk/index.ts",
      "default": "./src/sdk/index.ts"
    },
    "./react": {
      "types": "./src/sdk/react.tsx",
      "default": "./src/sdk/react.tsx"
    },
    "./styles.css": "./src/sdk/nori.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/sdk",
    "src/sdk",
    "!src/sdk/**/*.test.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --watch src/sidecar-server.ts",
    "start": "bun run src/sidecar-server.ts",
    "sidecar": "bun run src/sidecar-server.ts",
    "digest": "bun run src/cli/digest.ts",
    "build": "bun run build:sdk",
    "build:sdk": "rm -rf dist/sdk && tsc -p tsconfig.sdk.json",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.2"
  }
}
