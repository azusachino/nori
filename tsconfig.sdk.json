{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/sdk",
    "rootDir": "./src/sdk",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/sdk/index.ts", "src/sdk/react.tsx"]
}
